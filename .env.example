# Postgres connection string (required). Locally: see README "Database" for a
# one-line Docker setup. On Vercel: Neon's *pooled* connection string (the
# host containing "-pooler").
DATABASE_URL=postgres://postgres:elocu@localhost:5432/elocu

# Clerk (sign-in) — required; the app won't serve pages without them. Create
# an application at https://dashboard.clerk.com and copy its API keys here
# (and into the Vercel project for production).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Per-user caps on LLM calls (lib/rateLimit.ts), shared across every AI
# route. Defaults: 20 per minute, 300 per day (a full session is ~15 calls).
# RATE_LIMIT_PER_MINUTE=20
# RATE_LIMIT_PER_DAY=300

# Get a key at https://console.groq.com/keys. Primary provider for both
# conversation and grading (see lib/llm.ts) — speed via custom inference
# hardware is Groq's whole value proposition, which matters for both: the
# live conversation loop is obviously latency-sensitive, but grading is too
# since the browser waits on it during pause/end.
GROQ_API_KEY=
# GROQ_MODEL_CONVERSATION=openai/gpt-oss-20b
# GROQ_MODEL_GRADING=openai/gpt-oss-20b
# Groq's available models change over time — if either default 404s with
# model_not_found, check `GET https://api.groq.com/openai/v1/models` against
# your own key for the current list (see plan.md §24 for how this was
# diagnosed and re-picked once already).

# Get a key at https://openrouter.ai/keys. Second-tier fallback if Groq
# fails for any reason (missing key, timeout, bad response) — lib/llm.ts's
# chatCompletion() tries this next before giving up.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL_CONVERSATION=google/gemma-4-26b-a4b-it:free
# OPENROUTER_MODEL_GRADING=google/gemma-4-26b-a4b-it:free
# Primary (not fallback) for the goal-suggestion call (lib/objectiveSuggestion.ts)
# — deliberately no Groq in that chain. Benchmarked against local Ollama and
# picked for accuracy on free-text goal -> metric mapping, not speed.
# OPENROUTER_MODEL_SUGGESTION=google/gemma-4-26b-a4b-it:free

# Third-tier fallback: local Ollama (https://ollama.com), used only if both
# Groq and OpenRouter fail. No API key needed. Requires Ollama running
# locally with the model already pulled (e.g. `ollama pull llama3.2`).
# OLLAMA_MODEL_CONVERSATION=llama3.2
# OLLAMA_MODEL_GRADING=llama3.2
# OLLAMA_URL=http://localhost:11434/v1/chat/completions
# Fallback (not primary) for the goal-suggestion call — see OPENROUTER_MODEL_SUGGESTION above.
# OLLAMA_MODEL_SUGGESTION=llama3.2
